generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum VerificationType {
  EMAIL
  SMS
}
model User {
  id String @id @default(cuid())
  email String? @unique
  phone String? @unique
  name String?
  createdAt DateTime @default(now())
  sessions Session[]
  resumes Resume[]
  profile Profile?
}
model Resume {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName String
  mimeType String
  rawText String
  storageKey String @unique
  createdAt DateTime @default(now())
  isPrimary Boolean @default(true)
  @@index([userId])
}
model Profile {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline String
  summary String
  skills String[]
  titles String[]
  yearsExperience Float?
  locations String[]
  seniority String
  experience Json
  education Json
  updatedAt DateTime @updatedAt
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}
model VerificationToken {
  id String @id @default(cuid())
  identifier String
  tokenHash String
  type VerificationType
  expiresAt DateTime
  attempts Int @default(0)
  createdAt DateTime @default(now())
  @@index([identifier, type, createdAt])
}
