generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
enum VerificationType {
  EMAIL
  SMS
}
model User {
  id String @id @default(cuid())
  email String? @unique
  phone String? @unique
  name String?
  createdAt DateTime @default(now())
  sessions Session[]
  resumes Resume[]
  profile Profile?
  jobMatches JobMatch[]
  tailoredResumes TailoredResume[]
  coverLetters CoverLetter[]
  contacts Contact[]
  outreachDrafts OutreachDraft[]
  applications Application[]
}
enum MatchStatus {
  SAVED
  HIDDEN
}
model Job {
  id String @id @default(cuid())
  source String
  externalId String
  title String
  company String
  location String
  remote Boolean
  url String
  description String
  salaryMin Float?
  salaryMax Float?
  currency String?
  postedAt DateTime?
  employmentType String?
  fingerprint String
  fetchedAt DateTime @default(now())
  matches JobMatch[]
  tailoredResumes TailoredResume[]
  coverLetters CoverLetter[]
  outreachDrafts OutreachDraft[]
  applications Application[]
  @@unique([source, externalId])
  @@index([fingerprint])
}
model TailoredResume {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId String
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  content Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  applications Application[]
  @@index([userId, jobId])
}
model CoverLetter {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId String
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  body String
  createdAt DateTime @default(now())
  applications Application[]
  @@index([userId, jobId])
}
enum ContactSource {
  LINKEDIN_EXPORT
  MANUAL
}
enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}
enum ApplicationEventType {
  STATUS_CHANGE
  NOTE
  FOLLOW_UP
}
model Application {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId String?
  job Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  company String
  title String
  url String @default("")
  status ApplicationStatus @default(SAVED)
  appliedAt DateTime?
  nextFollowUpAt DateTime?
  notes String @default("")
  tailoredResumeId String?
  tailoredResume TailoredResume? @relation(fields: [tailoredResumeId], references: [id], onDelete: SetNull)
  coverLetterId String?
  coverLetter CoverLetter? @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events ApplicationEvent[]
  @@unique([userId, jobId])
  @@index([userId, status])
  @@index([userId, nextFollowUpAt])
}
model ApplicationEvent {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type ApplicationEventType
  from String?
  to String?
  note String?
  createdAt DateTime @default(now())
  @@index([applicationId, createdAt])
}
model Contact {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName String
  email String?
  company String
  position String
  connectedOn DateTime?
  source ContactSource
  linkedinUrl String?
  identityKey String
  outreachDrafts OutreachDraft[]
  @@unique([userId, identityKey])
  @@index([userId])
}
enum OutreachChannel {
  LINKEDIN
  EMAIL
}
model OutreachDraft {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId String
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contactId String?
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  channel OutreachChannel
  subject String
  body String
  createdAt DateTime @default(now())
  @@index([userId, jobId])
}
model JobMatch {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId String
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  score Int
  matchedSkills String[]
  missingSkills String[]
  reasons Json
  status MatchStatus?
  @@unique([userId, jobId])
  @@index([userId, score])
}
model Resume {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName String
  mimeType String
  rawText String
  storageKey String @unique
  createdAt DateTime @default(now())
  isPrimary Boolean @default(true)
  @@index([userId])
}
model Profile {
  email String @default("")
  phone String @default("")
  linkedinUrl String @default("")
  website String @default("")
  location String @default("")
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline String
  summary String
  skills String[]
  titles String[]
  yearsExperience Float?
  locations String[]
  seniority String
  experience Json
  education Json
  updatedAt DateTime @updatedAt
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}
model VerificationToken {
  id String @id @default(cuid())
  identifier String
  tokenHash String
  type VerificationType
  expiresAt DateTime
  attempts Int @default(0)
  createdAt DateTime @default(now())
  @@index([identifier, type, createdAt])
}
