generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
enum VerificationType {
  EMAIL
  SMS
}
model User {
  id String @id @default(cuid())
  email String? @unique
  phone String? @unique
  name String?
  createdAt DateTime @default(now())
  sessions Session[]
  resumes Resume[]
  profile Profile?
  jobMatches JobMatch[]
}
enum MatchStatus {
  SAVED
  HIDDEN
}
model Job {
  id String @id @default(cuid())
  source String
  externalId String
  title String
  company String
  location String
  remote Boolean
  url String
  description String
  salaryMin Float?
  salaryMax Float?
  currency String?
  postedAt DateTime?
  employmentType String?
  fingerprint String
  fetchedAt DateTime @default(now())
  matches JobMatch[]
  @@unique([source, externalId])
  @@index([fingerprint])
}
model JobMatch {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId String
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  score Int
  matchedSkills String[]
  missingSkills String[]
  reasons Json
  status MatchStatus?
  @@unique([userId, jobId])
  @@index([userId, score])
}
model Resume {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName String
  mimeType String
  rawText String
  storageKey String @unique
  createdAt DateTime @default(now())
  isPrimary Boolean @default(true)
  @@index([userId])
}
model Profile {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline String
  summary String
  skills String[]
  titles String[]
  yearsExperience Float?
  locations String[]
  seniority String
  experience Json
  education Json
  updatedAt DateTime @updatedAt
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}
model VerificationToken {
  id String @id @default(cuid())
  identifier String
  tokenHash String
  type VerificationType
  expiresAt DateTime
  attempts Int @default(0)
  createdAt DateTime @default(now())
  @@index([identifier, type, createdAt])
}
